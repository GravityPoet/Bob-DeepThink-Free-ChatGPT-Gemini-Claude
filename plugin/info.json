  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "provider",
      "type": "menu",
      "title": "接口类型",
      "defaultValue": "openai",
      "menuValues": [
        {
          "title": "OpenAI 接口 / 兼容接口",
          "value": "openai"
        },
        {
          "title": "Gemini 官方接口",
          "value": "gemini"
        },
        {
          "title": "AWS Bedrock 官方链路",
          "value": "bedrock"
        },
        {
          "title": "其他完整端点",
          "value": "custom"
        }
      ],
      "desc": "先选接口类型，不按模型品牌选。CPA/Sub2API/OpenAI 兼容地址选“OpenAI 接口 / 兼容接口”；Google 官方 /v1beta 选“Gemini 官方接口”；直连 AWS 官方 Bedrock 选“AWS Bedrock 官方链路”，可用 Bedrock API Key 或 AWS IAM SigV4。"
    },
    {
      "identifier": "apiMode",
      "type": "menu",
      "title": "接口协议",
      "defaultValue": "chat_completions",
      "menuValues": [
        {
          "title": "Chat Completions（兼容接口）",
          "value": "chat_completions"
        },
        {
          "title": "Responses API",
          "value": "responses"
        },
        {
          "title": "Gemini Native（官方 /v1beta）",
          "value": "gemini_generate_content"
        },
        {
          "title": "AWS Converse（Claude 官方）",
          "value": "aws_converse"
        }
      ],
      "desc": "兼容接口通常选 Chat Completions；OpenAI Responses 选 Responses API；Google 官方 Gemini /v1beta 选 Gemini Native。AWS IAM 双密钥调用 Claude 选 AWS Converse。"
    },
    {
      "identifier": "baseUrl",
      "type": "text",
      "title": "接口地址",
      "desc": "填写 Base URL 或完整端点。CPA/兼容接口示例：https://api.example.com/v1；AWS Bedrock API Key 调 OpenAI 模型示例：https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1；AWS Converse 可留默认或填 https://bedrock-runtime.us-east-1.amazonaws.com。",
      "defaultValue": "http://127.0.0.1:18080/v1",
      "textConfig": {
        "placeholderText": "https://api.example.com/v1",
        "type": "visible"
      }
    },
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "API Key（网关 / Bedrock API Key）",
      "desc": "CPA、Sub2API、OpenAI 兼容网关、Mantle/Bearer 路线，以及 Amazon Bedrock API Key 都填这里。若使用 AWS IAM Access Key ID / Secret Access Key，则填下面两个 AWS 密钥。",
      "textConfig": {
        "placeholderText": "sk-... 或 ABSK...",
        "type": "secure"
      }
    },
    {
      "identifier": "awsAccessKeyId",
      "type": "text",
      "title": "AWS Access Key ID（仅 AWS Bedrock）",
      "desc": "使用 AWS IAM SigV4 / AWS Converse 调 Claude 时填写。若使用 Amazon Bedrock API Key 调 OpenAI 模型，则不用填。",
      "textConfig": {
        "placeholderText": "AKIA...",
        "type": "secure"
      }
    },
    {
      "identifier": "awsSecretAccessKey",
      "type": "text",
      "title": "AWS Secret Access Key（仅 AWS Bedrock）",
      "desc": "使用 AWS IAM SigV4 / AWS Converse 调 Claude 时填写。若使用 Amazon Bedrock API Key 调 OpenAI 模型，则不用填。",
      "textConfig": {
        "placeholderText": "xxxxxxxx",
        "type": "secure"
      }
    },
    {
      "identifier": "awsSessionToken",
      "type": "text",
      "title": "AWS Session Token（可选）",
      "desc": "使用 STS 临时凭证时填写；长期 IAM Access Key 或 Amazon Bedrock API Key 留空。",
      "textConfig": {
        "placeholderText": "可选",
        "type": "secure"
      }
    },
