      ],
      "desc": "选择预设模型；没有就选“自定义模型”，再在下一项填写真实模型名。"
    },
    {
      "identifier": "customModel",
      "type": "text",
      "title": "自定义模型名",
      "desc": "当“模型”选择自定义模型时填写，例如 global.anthropic.claude-sonnet-4-6、openai.gpt-oss-20b-1:0、gemini-3.5-flash-low。",
      "textConfig": {
        "placeholderText": "例如: global.anthropic.claude-sonnet-4-6",
        "type": "visible"
      }
    },
    {
      "identifier": "streamOutput",
      "type": "menu",
      "title": "流式输出",
      "defaultValue": "true",
      "menuValues": [
        {
          "title": "开启",
          "value": "true"
        },
        {
          "title": "关闭",
          "value": "false"
        }
      ],
      "desc": "建议开启。若上游流式没有返回正文，插件会自动回退一次非流式请求。"
    },
    {
      "identifier": "reasoningEffort",
      "type": "menu",
      "title": "高级：思考强度",
      "defaultValue": "none",
      "menuValues": [
        {
          "title": "无(不设置)",
          "value": "none"
        },
        {
          "title": "低",
          "value": "low"
        },
        {
          "title": "中",
          "value": "medium"
        },
        {
          "title": "高",
          "value": "high"
        }
      ],
      "desc": "默认“无”最稳。兼容接口会按协议传 reasoning_effort 或 reasoning.effort；Gemini Native 不传。"
    },
    {
      "identifier": "maxOutputTokens",
      "type": "text",
      "title": "高级：最大输出 Token",
      "defaultValue": "1024",
      "desc": "范围 64-8192。普通翻译保持默认即可。",
      "textConfig": {
        "placeholderText": "1024",
        "type": "visible"
      }
    },
    {
      "identifier": "requestTimeoutSec",
      "type": "text",
      "title": "高级：请求超时(秒)",
      "defaultValue": "90",
      "desc": "范围 10-300。网络慢或模型慢时再调大。",
      "textConfig": {
        "placeholderText": "90",
        "type": "visible"
      }
    },
    {
      "identifier": "bedrockRegion",
      "type": "text",
      "title": "AWS Region（仅 AWS Bedrock）",
      "defaultValue": "us-east-1",
      "desc": "AWS Bedrock 官方链路使用，例如 us-east-1。其他接口忽略。",
      "textConfig": {
        "placeholderText": "us-east-1",
        "type": "visible"
